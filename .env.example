# Postgres (docker-compose)
DATABASE_URL=postgres://coach:coach@localhost:5432/coach

# API
PORT=3000

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend API origin. Leave unset for local development: an empty value keeps every
# request relative so it goes through the Vite dev proxy. It is read at BUILD time by
# Vite, from apps/web — this root file does not reach it. Set it in the Render dashboard
# on the static site, or in apps/web/.env.local to point a local build at a deployed API.
# VITE_API_URL=https://api.trysourced.co
